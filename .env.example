# =============================================================================
# NYC Taxi & Weather Pipeline - Environment Variables
# =============================================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# =============================================================================

# --- NYC Open Data (Socrata) API ---
# Get a free app token at: https://data.cityofnewyork.us/profile/edit/developer_settings
SOCRATA_APP_TOKEN=your_socrata_app_token_here
SOCRATA_DOMAIN=data.cityofnewyork.us
# Yellow Taxi Trip Records 2024 dataset identifier
TAXI_DATASET_ID=m6nq-qud6

# --- NOAA CDO (Climate Data Online) API ---
# Request a free token at: https://www.ncdc.noaa.gov/cdo-web/token
NOAA_API_TOKEN=your_noaa_api_token_here
NOAA_STATION_ID=GHCND:USW00094728
NOAA_DATASET_ID=GHCND

# --- Google Cloud Storage ---
GCP_PROJECT_ID=your_gcp_project_id
GCS_BUCKET_NAME=nyc-taxi-weather-pipeline
GCS_RAW_TAXI_PREFIX=raw-taxi/
GCS_RAW_WEATHER_PREFIX=raw-weather/
# Path to your GCP service account key JSON
GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account-key.json

# --- MongoDB Atlas ---
# Connection string from MongoDB Atlas dashboard
MONGO_URI=mongodb+srv://username:password@cluster.xxxxx.mongodb.net/
MONGO_DB_NAME=nyc_taxi_weather

# --- Data Parameters ---
# Date range for data ingestion (YYYY-MM-DD)
DATA_START_DATE=2024-01-01
DATA_END_DATE=2024-12-31
# Number of taxi records to fetch per API call (max 50000 for Socrata)
TAXI_FETCH_LIMIT=50000
