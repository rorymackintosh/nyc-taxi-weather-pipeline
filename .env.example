# =============================================================================
# NYC Taxi & Weather Pipeline - Environment Variables
# =============================================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# =============================================================================

# --- NYC TLC Taxi Data ---
# Year of Yellow Taxi data to download (Parquet files from TLC CDN)
TAXI_YEAR=2023

# --- NOAA CDO (Climate Data Online) API ---
# Request a free token at: https://www.ncdc.noaa.gov/cdo-web/token
NOAA_API_TOKEN=your_noaa_api_token_here
NOAA_STATION_ID=GHCND:USW00094728
NOAA_DATASET_ID=GHCND

# --- Google Cloud Storage ---
GCP_PROJECT_ID=your_gcp_project_id
GCS_BUCKET_NAME=your_gcs_bucket_name
GCS_RAW_TAXI_PREFIX=raw-taxi/
GCS_RAW_WEATHER_PREFIX=raw-weather/
# Path to your GCP service account key JSON
GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account-key.json

# --- MongoDB Atlas ---
# Connection string from MongoDB Atlas dashboard (Drivers > Python)
MONGO_URI=
MONGO_DB_NAME=
# Number of taxi records to sample for MongoDB (free tier = 512 MB, ~700K fits)
MONGO_SAMPLE_SIZE=700000

# --- Data Parameters ---
# Date range for weather data (should match TAXI_YEAR)
DATA_START_DATE=2023-01-01
DATA_END_DATE=2023-12-31
